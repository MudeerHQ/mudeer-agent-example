# The Application you registered in Mudeer (Settings › API › Applications).
MUDEER_CLIENT_ID=
MUDEER_CLIENT_SECRET=
# The webhook secret shown with the Application; Mudeer signs every delivery with it.
MUDEER_WEBHOOK_SECRET=
# Where Mudeer sends the admin back after the install (must match the Application's callback URL).
MUDEER_REDIRECT_URI=https://agent.example/oauth/callback

# Optional. A token for one workspace (the developer token from the Application's page, or one
# minted with client credentials), used when no install has signed in through /oauth/callback.
MUDEER_AGENT_TOKEN=

# Mudeer's addresses; change only for a self-hosted Mudeer.
MUDEER_API=https://api.mudeer.co
MUDEER_MCP=https://mcp.mudeer.co/mcp
MUDEER_APP=https://app.mudeer.co

PORT=8787
